# Copy to .env and edit. scripts/serve.sh reads it; values already in your environment win.

# Where things live
TF_DIR=$HOME/TensorFold                    # clone of kinetick-labs/TensorFold at 001de3a7 (scripts/build.sh)
MODEL=$HOME/models/exl3-405                # turboderp/Qwen3.8-Flash-Next-exl3, 4.05bpw_h6_ng6
TENSORFOLD_CUDA_KERNELS=$HOME/tf-kernels/sm121   # captured Triton set: aot.json + cubins/ (must contain _ple_rows)
# multi profile (fp8 KV): a copy of the set with the kv8 kernels added, made once with
#   scripts/add-kv8.sh $HOME/tf-kernels/sm121 $HOME/tf-kernels-kv8/sm121
# TENSORFOLD_CUDA_KERNELS=$HOME/tf-kernels-kv8/sm121

# Server
HOST=127.0.0.1
PORT=8083
NAME=qwen3.8-flash-next
CONTEXT=262144

# Profile: single (1 stream, bf16 KV, draft depth 4: fastest per stream, exact published shas)
#          multi  (4 streams at 262k, fp8 KV, draft depth 3: most aggregate throughput)
PROFILE=single
# Explicit values override the profile:
# PARALLEL=4
# KV_DTYPE=fp8                             # bf16 or fp8 (fp8 needs the kv8 kernels)
# TF_FLASHNEXT_DEPTH=3                     # draft cap (engine default 4)
# TF_FLASHNEXT_PRODUCT_STREAMS=2           # product rule while <= N lanes draft, then wide_confidence (default 2)
# TF_FLASHNEXT_CONFIDENCE=-0.6             # running-product stop (default -0.6)
# TENSORFOLD_MEMORY_RESERVE_GIB=12         # memory kept free for the rest of the box (engine default ~12)
# EXTRA_ARGS="--thinking --reasoning-effort high --max-tokens 32768"

# Engine knobs (defaults are the measured points)
TF_FLASHNEXT_PREFILL_ROWS=4096             # prompt chunk rows (engine default 2048)
# TF_FLASHNEXT_X3_MOE_WINDOW=4096          # grouped-experts window (default 4096)
# TF_FLASHNEXT_TELEMETRY=1                 # one tf-draft line per round; tokens unchanged
