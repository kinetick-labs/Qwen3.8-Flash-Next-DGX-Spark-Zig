# Copy to .env and edit. scripts/serve.sh reads it; values already in your environment win.

# Where things live
TF_DIR=$HOME/TensorFold                    # clone of kinetick-labs/TensorFold, branch perf/zig-exl3-decode
MODEL=$HOME/models/exl3-405                # turboderp/Qwen3.8-Flash-Next-exl3, 4.05bpw_h6_ng6
TENSORFOLD_CUDA_KERNELS=$HOME/tf-kernels/sm121   # captured Triton set: aot.json + cubins/ (must contain _ple_rows)

# Server
HOST=127.0.0.1
PORT=8083
NAME=qwen3.8-flash-next
CONTEXT=262144
PARALLEL=2                                 # concurrent streams (1-4 measured, see bench/results.md)
KV_DTYPE=bf16                              # bf16 (default) or fp8

# Engine defaults on perf/zig-exl3-decode. Leave commented to use them.
TF_FLASHNEXT_PREFILL_ROWS=4096             # prompt chunk rows (engine default 2048; 4096 is the measured prefill point)
# TF_FLASHNEXT_X3_MOE_WINDOW=4096          # grouped-experts window (default 4096)
# TF_FLASHNEXT_DEPTH=4                     # draft cap (default 4)
# TF_FLASHNEXT_CONFIDENCE=-0.6             # running-product stop (default -0.6; positive = per-draft rule)
# TF_FLASHNEXT_PRODUCT_STREAMS=2           # product rule while <= N lanes draft, then wide_confidence
# TF_FLASHNEXT_TELEMETRY=1                 # one tf-draft line per round; tokens unchanged
