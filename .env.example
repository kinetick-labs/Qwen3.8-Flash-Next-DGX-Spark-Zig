# Optional overrides for scripts/build.sh and scripts/serve.sh (export them, or `set -a; . ./.env`).
# TF_DIR=$HOME/TensorFold            # clone of kinetick-labs/TensorFold
# TF_REF=082aee98a                     # pinned main commit
# ROOT=$HOME/tf-prod-df2g             # stable install root: bin/, libs/, COMMIT, serve.sh
# LIBS_FROM=/path/to/libs             # libtfgrammar.so, libturbojpeg.so*, libwebpdecoder.so*
# PORT=8083
# IMAGE=tensorfold-zig:exl3-572414d-runner  # runtime image + runner layer (scripts/runner-image/build.sh)
# BASE_IMAGE=tensorfold-zig:exl3-572414d    # runtime image (CUDA libs) the runner image builds on
# JL_DIR=$HOME/qwen4-tensorfold-spark       # Jay Leaton's repo: runner-assets fetch script and pins
# DFLASH=$HOME/models/qwen38-dflash2  # DFlash2 drafter
# VISION_W=$HOME/models/sxuff-vision-bf16
# MODEL_REVISION=b9ce18a6887e18c089fdea8509a33e63429a3300
# Compute lane (set in serve.sh): TF_COMPUTE_LANE=1 TF_COMPUTE_LANE_DEFAULT=1 offers the sandboxed python tool to
# thinking chats that bring no tools of their own; TF_COMPUTE_LANE_DEFAULT_WITH_TOOLS=1 also offers it next to a
# client's own tools (off by default: agents such as Hermes then render exactly as without the lane).
