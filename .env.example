# Optional overrides for scripts/build.sh and scripts/serve.sh (export them, or `set -a; . ./.env`).
# TF_DIR=$HOME/TensorFold            # clone of kinetick-labs/TensorFold
# TF_REF=80071f40c                     # pinned main commit
# ROOT=$HOME/tf-prod-df2g             # stable install root: bin/, libs/, COMMIT, serve.sh
# LIBS_FROM=/path/to/libs             # libtfgrammar.so, libturbojpeg.so*, libwebpdecoder.so*
# PORT=8083
# IMAGE=tensorfold-zig:exl3-572414d   # runtime image (CUDA libs only)
# DFLASH=$HOME/models/qwen38-dflash2  # DFlash2 drafter
# VISION_W=$HOME/models/sxuff-vision-bf16
# MODEL_REVISION=b9ce18a6887e18c089fdea8509a33e63429a3300
